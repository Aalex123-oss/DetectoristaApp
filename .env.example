# Root convenience file: copy to backend/.env and frontend/.env.local as needed.
# Every value below is optional - the stack boots and returns real reports without any key.

# ---- Backend (copy into backend/.env) --------------------------------------
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
USER_AGENT=DetectoristaWebGIS/1.0 (contact: gis@example.org)

# Geocoding (Nominatim primary, Photon fallback)
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
PHOTON_BASE_URL=https://photon.komoot.io

# Knowledge providers
WIKIPEDIA_BASE_URL=https://en.wikipedia.org/w/api.php
WIKIPEDIA_LANGUAGE=en
INTERNET_ARCHIVE_BASE_URL=https://archive.org/advancedsearch.php
EUROPEANA_BASE_URL=https://api.europeana.eu/record/v2/search.json
# Free key: https://pro.europeana.eu/pages/get-api - Europeana is skipped when unset.
EUROPEANA_API_KEY=

# Optional LLM narrative refinement (OpenAI-compatible). Heuristic synthesis is used when unset.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Research tuning
RESEARCH_RADIUS_METERS=5000
CACHE_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=20

# ---- Frontend (copy into frontend/.env.local) ------------------------------
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
# Optional: enables Mapbox Satellite basemap instead of Esri imagery fallback.
MAPBOX_ACCESS_TOKEN=
