# ---------------------------------------------------------------------------
# Detectorista Web GIS — backend configuration
# Copy to backend/.env and fill in the keys you have. Every key is OPTIONAL:
# the research engine degrades gracefully and reports provider status per call.
# ---------------------------------------------------------------------------

ENVIRONMENT=development

# Contact string sent to Nominatim / IGN services (required by their usage policy).
USER_AGENT=DetectoristaWebGIS/1.0 (contact: you@example.org)

# Comma separated list of frontend origins allowed by CORS.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Geocoding + knowledge bases
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Fallback OSM geocoder used when Nominatim rate-limits the server IP.
PHOTON_BASE_URL=https://photon.komoot.io
WIKIPEDIA_BASE_URL=https://en.wikipedia.org/w/api.php
WIKIPEDIA_LANGUAGE=en
INTERNET_ARCHIVE_BASE_URL=https://archive.org/advancedsearch.php

# Europeana cultural heritage API — free key: https://pro.europeana.eu/pages/get-api
EUROPEANA_API_KEY=

# Optional LLM synthesis of the historical narrative (OpenAI compatible endpoint).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Optional Mapbox basemap (adds "Mapbox Satellite Streets" to the layer catalogue).
MAPBOX_ACCESS_TOKEN=

# Research tuning
SEARCH_RADIUS_METERS=10000
MAX_SOURCES_PER_PROVIDER=8
RESEARCH_CACHE_TTL_SECONDS=900
HTTP_TIMEOUT_SECONDS=20
